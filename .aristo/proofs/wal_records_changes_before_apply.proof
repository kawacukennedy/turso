[verdict]
type = "verified"
method = "neural"
produced_at_text_hash = "sha256:85270d4acbf9d93ad70d71d3c5a3a4863616dba36abb529bd7d12244e615e79e"
produced_at_body_hash = "sha256:3627e8fd855d64d269a1c927fe4a88b02e1edd4db64e2ffc93b704d24b701552"
produced_by = "aristo-neural-verifier@v0.0.7"
attempts = 3
property_kind = "invariant"

[verified.proof]
conclusion = "The Wal trait defines an append-only log whose page-level changes are recorded (and made durable) in the log before they are applied to the database file, so that a crash is recoverable by replaying the logged frames."

[[verified.proof.steps]]
path = "0"
claim = "The trait's write path records page changes as appended WAL frames that only count as committed once durably written, and a separate checkpoint path is what later applies those frames to the database file; this ordering makes the log the authoritative recoverable record on crash."
relation_to_parent = "decomposes"
subgoal_paths = [
    "0.0",
    "0.1",
    "0.2",
]

[[verified.proof.steps.grounds]]
kind = "composition"
reason = "The intent holds iff (0.0) changes are first recorded durably in the log AND (0.1) they are applied to the db only after being durably logged AND (0.2) the log surface is append-only and replayable; the three subgoals combine via AND."

[[verified.proof.steps]]
path = "0.0"
claim = "Page-level changes are recorded into the log by appending frames, and a transaction's appended frames become committed/visible only after they have been durably written and synced — establishing 'records changes' durably before any apply."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "intent"
id = "committed_frames_visible_only_after_durable"
at_text_hash = "sha256:74c9ab83ffb8f941a7af5f5c9917f2d082bc6753ca8bb0f62de7dac42fe1f83f"
relation = "instantiates"
reason = "finish_append_frames_commit guarantees appended frames become visible only after a durable write+sync, which is precisely the 'records page-level changes' (and persists them) half of this high-level intent."

[[verified.proof.steps.grounds]]
kind = "code"
file = "core/storage/wal.rs"
lines = "699-725"
code_text_hash = "sha256:f244c14f50cf18f4431094ee1b1dd0000ac8e9c65a55afc2918c8ba47452e869"
reason = "prepare_frames/commit_prepared_frames/append_frames_vectored/finish_append_frames_commit form the append-only record-and-commit surface for page changes."

[[verified.proof.steps]]
path = "0.1"
claim = "Frames are applied to the database file only via the checkpoint/backfill path, and the published backfill watermark advances only after the covered database pages are durably written and synced — so frames are applied to the db strictly after they were durably recorded in the log."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "intent"
id = "backfill_watermark_advances_only_after_durable"
at_text_hash = "sha256:41ecf517973ba246f2906d32769b4fc1dbe366b30a71431402629bff6306d4dd"
relation = "composes"
reason = "publish_backfill advances the apply-watermark only after the db-file pages it covers are durably written, establishing that 'apply to the database' never precedes durable logging."

[[verified.proof.steps.grounds]]
kind = "code"
file = "core/storage/wal.rs"
lines = "4513-4529"
code_text_hash = "sha256:3964206081c96d87974cd0a348bb1b4098828feb5ac9419a73d9b8d6cbc7b3eb"
reason = "checkpoint_inner is the only path that backfills WAL frames (max_frame > nbackfills) into the database file, confirming apply-to-db happens after frames are already in the log."

[[verified.proof.steps]]
path = "0.2"
claim = "The recorded frames are an append-only, replayable log: the trait exposes read_frame/read_frame_raw/find_frame over frames and a checkpoint that copies them into the db, so on crash the as-yet-unapplied logged frames can be replayed into the database."
relation_to_parent = "composes"

[[verified.proof.steps.grounds]]
kind = "code"
file = "core/storage/wal.rs"
lines = "646-678"
code_text_hash = "sha256:7a5bfad72e6cbfd2e90261019a6b68559aff2b7c81cf20518b7285106e65b6b2"
reason = "find_frame/read_frame/read_frame_raw read previously appended frames by frame id, the read side of an append-only log."

[[verified.proof.steps.grounds]]
kind = "code"
file = "core/storage/wal.rs"
lines = "727-737"
code_text_hash = "sha256:21dafdc9e0869440583f32ef6d5521fd4d37564d4444a89c0fe8cda24cd6b2c5"
reason = "checkpoint/publish_backfill apply logged frames to the database; the same machinery replays not-yet-backfilled durable frames after a crash."

[[verified.proof.steps.grounds]]
kind = "prior-step"
path = "0.0"

[[verified.proof.steps.grounds]]
kind = "prior-step"
path = "0.1"
